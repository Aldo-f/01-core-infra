#!/usr/bin/env python3
"""Flask server for neo-brutalist homepage with dynamic metrics."""
import json
import os
import subprocess
from datetime import datetime
from flask import Flask, jsonify, send_from_directory

app = Flask(__name__, static_folder='/var/www/06-apps-neo-brutalist-home')

PORT = 8081
SITE_ROOT = '/var/www/06-apps-neo-brutalist-home'

@app.route('/')
def index():
    return send_from_directory(SITE_ROOT, 'index.html')

@app.route('/style.css')
def style():
    return send_from_directory(SITE_ROOT, 'style.css')

@app.route('/metrics.json')
def metrics():
    """Generate metrics JSON dynamically."""
    metrics = {}

    # Uptime
    try:
        with open('/proc/uptime') as f:
            uptime_seconds = int(float(f.read().split()[0]))
        metrics['uptime_seconds'] = uptime_seconds
        days = uptime_seconds // 86400
        hours = (uptime_seconds % 86400) // 3600
        mins = (uptime_seconds % 3600) // 60
        metrics['uptime'] = f"{days}d {hours}h {mins}m"
    except Exception:
        metrics['uptime'] = 'N/A'
        metrics['uptime_seconds'] = 0

    # RAM
    try:
        with open('/proc/meminfo') as f:
            meminfo = f.read()
        mem_total = int([line for line in meminfo.split('\n') if 'MemTotal' in line][0].split()[1])
        mem_available = int([line for line in meminfo.split('\n') if 'MemAvailable' in line][0].split()[1])
        mem_used = mem_total - mem_available
        metrics['ram_used_gb'] = f"{mem_used / 1048576:.2f}"
        metrics['ram_total_gb'] = f"{mem_total / 1048576:.2f}"
        metrics['ram_percent'] = round(mem_used * 100 / mem_total, 1)
    except Exception:
        metrics['ram_used_gb'] = 'N/A'
        metrics['ram_total_gb'] = 'N/A'
        metrics['ram_percent'] = 0

    # SSD (root)
    try:
        result = subprocess.run(['df', '-B1', '/'], capture_output=True, text=True)
        lines = result.stdout.strip().split('\n')
        parts = lines[1].split()
        ssd_total = int(parts[1])
        ssd_used = int(parts[2])
        ssd_percent = int(parts[4].replace('%', ''))
        metrics['ssd_used_gb'] = f"{ssd_used / 1073741824:.2f}"
        metrics['ssd_total_gb'] = f"{ssd_total / 1073741824:.2f}"
        metrics['ssd_percent'] = ssd_percent
    except Exception:
        metrics['ssd_used_gb'] = 'N/A'
        metrics['ssd_total_gb'] = 'N/A'
        metrics['ssd_percent'] = 0

    # HDD1
    hdd1_percent = 0
    hdd1_used_gb = 'N/A'
    hdd1_total_gb = 'N/A'
    if os.path.isdir('/mnt/HDD1'):
        try:
            result = subprocess.run(['df', '-B1', '/mnt/HDD1'], capture_output=True, text=True)
            lines = result.stdout.strip().split('\n')
            parts = lines[1].split()
            hdd1_total = int(parts[1])
            hdd1_used = int(parts[2])
            hdd1_percent = int(parts[4].replace('%', ''))
            hdd1_total_gb = f"{hdd1_total / 1073741824:.2f}"
            hdd1_used_gb = f"{hdd1_used / 1073741824:.2f}"
        except Exception:
            pass
    metrics['hdd1_used_gb'] = hdd1_used_gb
    metrics['hdd1_total_gb'] = hdd1_total_gb
    metrics['hdd1_percent'] = hdd1_percent

    # CPU Load
    try:
        with open('/proc/loadavg') as f:
            load = f.read().split()
        metrics['cpu_load_1m'] = float(load[0])
        metrics['cpu_load_5m'] = float(load[1])
        metrics['cpu_load_15m'] = float(load[2])
    except Exception:
        metrics['cpu_load_1m'] = 0
        metrics['cpu_load_5m'] = 0
        metrics['cpu_load_15m'] = 0

    # CPU Temp
    cpu_temp = 'N/A'
    for path in ['/sys/class/thermal/thermal_zone0/temp', '/sys/class/hwmon/hwmon0/temp1_input']:
        if os.path.isfile(path):
            try:
                with open(path) as f:
                    raw = int(f.read().strip())
                    cpu_temp = str(raw // 1000)
                break
            except Exception:
                pass
    metrics['cpu_temp_celsius'] = cpu_temp

    # Subsite count
    try:
        with open('/home/aldo/dev/04-network-traefik/routes.yml') as f:
            routes = f.read()
        host_count = routes.count('Host(')
        metrics['subsite_count'] = host_count // 2
    except Exception:
        metrics['subsite_count'] = 0

    metrics['last_updated'] = datetime.now().isoformat()

    return jsonify(metrics)

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=PORT)