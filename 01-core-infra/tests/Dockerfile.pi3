FROM arm32v7/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    git \
    curl \
    sudo \
    unzip \
    zstd \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash -u 1000 aldo && \
    echo "aldo ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

USER aldo
WORKDIR __CORE_INFRA__

RUN python3 -m venv /home/aldo/.venv && \
    /home/aldo/.venv/bin/pip install --upgrade pip && \
    /home/aldo/.venv/bin/pip install ansible

ENV PATH="/home/aldo/.venv/bin:$PATH"

CMD ["/bin/bash"]
