# FreeLLMAPI environment — rendered by Ansible from vault
# (01-core-infra/vaults/freellmapi-credentials.yml). DO NOT edit manually:
# any ansible run re-renders this file. Never commit this file (in .gitignore).

# Server encryption key for API key storage (64-char hex). Decrypts the API
# keys stored in the SQLite DB (docker volume 02-ai-freellm_freellmapi-data).
ENCRYPTION_KEY={{ vault_freellmapi_encryption_key }}

# Server port (default: 3001)
PORT={{ vault_freellmapi_port }}

# Docker only: host interface the container's port is published on.
# 0.0.0.0 = reachable from LAN (http://192.168.0.5:3001)
HOST_BIND={{ vault_freellmapi_host_bind }}

# Request analytics retention
REQUEST_ANALYTICS_RETENTION_DAYS={{ vault_freellmapi_analytics_retention_days }}
REQUEST_ANALYTICS_MAX_ROWS={{ vault_freellmapi_analytics_max_rows }}
